# Copy to backend/mobile/.env on the phone and edit.

# Port the API listens on (the phone's LAN IP + this port for same-Wi-Fi access)
PORT=8200

# Frontend origin(s) allowed to call this API, comma-separated. Leave empty to allow any.
CORS_ALLOWED_ORIGINS=

# Cloudflare named-tunnel token for a stable public URL (e.g. api.intelreport.in).
# Leave empty to use a temporary *.trycloudflare.com URL instead.
CLOUDFLARE_TUNNEL_TOKEN=
